<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RentalCar.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RentalCar.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    mc:Ignorable="d">

    <NavigationView x:Name="NavView"
                    PaneDisplayMode="Left" OpenPaneLength="260"
                    IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    IsPaneToggleButtonVisible="False"
                    SelectionChanged="NavView_SelectionChanged">

        <!--Đầu menu: icon app + tên app. logo thẳng cột với icon các mục menu bên dưới-->
        <NavigationView.PaneHeader>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="10 14 12 10">
                <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-64.png"
                       Width="36" Height="36" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="CarRent" Style="{StaticResource BodyStrongTextBlockStyle}"
                               FontSize="16"/>
                    <TextBlock Text="Quản lý cho thuê xe" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </NavigationView.PaneHeader>

        <!--Các mục menu chính-->
        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="Không gian cửa hàng"/>

            <NavigationViewItem Content="Tổng quan" Tag="Dashboard" Icon="Home"/>

            <NavigationViewItem Content="Quản lý xe" Tag="Cars">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEB47;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Bãi xe &amp; chìa khoá" Tag="Parking" Icon="Pin"/>
            <NavigationViewItem Content="Khách hàng" Tag="Customers" Icon="People"/>
            <NavigationViewItem Content="Hợp đồng thuê" Tag="Contracts">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEE56;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Thanh toán" Tag="Payments">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8C7;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!--Chỉ Admin thấy-->
            <NavigationViewItem Content="Báo cáo" Tag="Reports"
                                Visibility="{x:Bind ViewModel.IsAdmin}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D9;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Quy định" Tag="Settings"
                    Visibility="{x:Bind ViewModel.IsAdmin}">
                <NavigationViewItem.Icon>
                    <AnimatedIcon>
                        <AnimatedIcon.Source>
                            <animatedvisuals:AnimatedSettingsVisualSource/>
                        </AnimatedIcon.Source>
                        <AnimatedIcon.FallbackIconSource>
                            <FontIconSource Glyph="&#xE713;"/>
                        </AnimatedIcon.FallbackIconSource>
                    </AnimatedIcon>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!--Chỉ Admin thấy-->
            <NavigationViewItem Content="Tài khoản nhân viên" Tag="Users"
            Visibility="{x:Bind ViewModel.IsAdmin}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE72E;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!--Thẻ người dùng dưới cùng (giống khung "Nguyễn Văn Admin")-->
        <NavigationView.PaneFooter>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12 8">
                <PersonPicture x:Name="UserAvatar" Width="32" Height="32"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.UserName}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.UserRoleText}" FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Command="{x:Bind ViewModel.LogoutCommand}" ToolTipService.ToolTip="Đăng xuất"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xF3B1;" FontSize="14"/>
                </Button>
            </Grid>
        </NavigationView.PaneFooter>

        <!--Vùng nội dung: tiêu đề trang + Frame-->
        <Grid RowDefinitions="Auto,*" Padding="24 12 24 24">
            <TextBlock Grid.Row="0" Style="{StaticResource TitleTextBlockStyle}"/>
            <Frame x:Name="ContentFrame" Grid.Row="1" Margin="0 12 0 0"/>
        </Grid>
    </NavigationView>
</Page>
