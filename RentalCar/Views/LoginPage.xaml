<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RentalCar.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RentalCar.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <!--Khung trắng chứa 2 cột-->
        <Border VerticalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--Left Column-->
                <Grid Grid.Column="0" Padding="40 36 40 28" RowSpacing="12" CornerRadius="8 0 0 8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F4F9FE" Offset="0"/>
                            <GradientStop Color="#E3EEF9" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!--Row 0-->
                    <Border Grid.Row="0" HorizontalAlignment="Left" Padding="12 4" CornerRadius="13"
                            Background="White" BorderBrush="#29005FB8" BorderThickness="1">
                        <TextBlock Text="Hệ thống quản lý cho thuê xe" FontSize="12" FontWeight="SemiBold" Foreground="#005FB8"/>
                    </Border>

                    <!--Row 1-->
                    <TextBlock Grid.Row="1" FontSize="32" FontWeight="SemiBold">
                        <Run Text="Vận hành cửa hàng."/>
                        <LineBreak/>
                        <Run Text="Rõ từng chuyến xe." Foreground="#005FB8"/>
                    </TextBlock>

                    <!--Row 2-->
                    <TextBlock Grid.Row="2" MaxWidth="380" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Text="Hợp đồng, vị trí đỗ và chìa khóa trong một không gian làm việc."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!--Dòng 3-->
                    <Image Grid.Row="3" Source="ms-appx:///Assets/login-parking.svg" Stretch="Uniform" Margin="0 8"/>

                    <!--Dòng 4-->
                    <!--Dải tính năng: nền trong suốt, gạch ngang trên/dưới mờ dần 2 đầu, gạch dọc ngăn cách-->
                    <Grid Grid.Row="4" RowSpacing="14">
                        <Grid.Resources>
                            <LinearGradientBrush x:Key="FeatureLineBrush" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00005FB8" Offset="0"/>
                                <GradientStop Color="#38005FB8" Offset="0.18"/>
                                <GradientStop Color="#38005FB8" Offset="0.82"/>
                                <GradientStop Color="#00005FB8" Offset="1"/>
                            </LinearGradientBrush>
                            <LinearGradientBrush x:Key="FeatureDividerBrush" StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#1F000000" Offset="0.3"/>
                                <GradientStop Color="#1F000000" Offset="0.7"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Rectangle Grid.Row="0" Height="1" Fill="{StaticResource FeatureLineBrush}"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!--Mục 1: Tra cứu nhanh-->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Padding="0 2 18 2">
                                <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="#005FB8"/>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Tra cứu nhanh" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Vị trí xe &amp; chìa" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource FeatureDividerBrush}"/>

                            <!--Mục 2: Giao / nhận xe (bút ký, giống icon Hợp đồng thuê ở sidebar)-->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Padding="18 2">
                                <FontIcon Glyph="&#xEE56;" FontSize="20" Foreground="#0B8A6F"/>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Giao / nhận xe" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Theo hợp đồng" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource FeatureDividerBrush}"/>

                            <!--Mục 3: Phân quyền-->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" Padding="18 2 0 2">
                                <FontIcon Glyph="&#xE72E;" FontSize="20" Foreground="#C46A00"/>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Phân quyền" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Admin · Nhân viên" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Rectangle Grid.Row="2" Height="1" Fill="{StaticResource FeatureLineBrush}"/>
                    </Grid>
                </Grid>

                <!--Right Column-->
                <StackPanel Grid.Column="1" Padding="56 36" Spacing="16" VerticalAlignment="Center">

                    <!--Avatar-->
                    <Border Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Left" Background="#E6F0FA">
                        <FontIcon Glyph="&#xE77B;" FontSize="22" Foreground="#005FB8"/>
                    </Border>

                    <!--Tiêu đề + mô tả-->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Đăng nhập" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock Text="Sử dụng tài khoản được cửa hàng cấp."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!--Ô tên đăng nhập + dòng lỗi-->
                    <StackPanel Spacing="6">

                        <TextBox Header="Tên đăng nhập" PlaceholderText="Nhập tên đăng nhập"
                                 Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    Visibility="{x:Bind ViewModel.HasUsernameError, Mode=OneWay}">
                            <FontIcon Glyph="&#xE783;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.UsernameError, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!--Ô mật khẩu + dòng lỗi-->
                    <StackPanel Spacing="6">
                        <PasswordBox Header="Mật khẩu" PlaceholderText="Nhập mật khẩu" PasswordRevealMode="Peek"
                                     Password="{x:Bind ViewModel.Password, Mode=TwoWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    Visibility="{x:Bind ViewModel.HasPasswordError, Mode=OneWay}">
                            <FontIcon Glyph="&#xE783;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.PasswordError, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!--Thông báo đăng nhập không thành công (ngay dưới Mật khẩu)-->
                    <InfoBar Severity="Error" Title="Đăng nhập không thành công"
                             Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.HasLoginError, Mode=TwoWay}"/>

                    <!--Nút đăng nhập + vòng xoay chờ-->
                    <Button Height="36" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.LoginCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!--Vòng xoay: chỉ hiện khi đang đăng nhập-->
                            <ProgressRing Width="16" Height="16" Foreground="White" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
                            <TextBlock Text="Đăng nhập"/>
                        </StackPanel>
                    </Button>

                    <!--Footer-->
                    <TextBlock Text="Dữ liệu lưu trên máy cục bộ" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
