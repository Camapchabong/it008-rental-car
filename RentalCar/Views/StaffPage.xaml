<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RentalCar.Views.StaffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RentalCar.Views"
    xmlns:vm="using:RentalCar.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:RentalCar.Controls" xmlns:models="using:RentalCar.Models"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" RowSpacing="24">

        <!--Row 0: Header Page-->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="VẬN HÀNH CỬA HÀNG" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80"
                               Foreground="{StaticResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="Tài khoản nhân viên" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold"/>
                <TextBlock Text="Tạo tài khoản, phân quyền và quản lý quyền truy cập."
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!--Button add account-->
            <Button Grid.Column="1" VerticalAlignment="Center" Height="40" Padding="18 0"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="AddUserButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="Thêm tài khoản" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!--Hàng 1: bảng-->
        <Border Grid.Row="1" VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid RowDefinitions="Auto,*">

                <!--Header table-->
                <Grid Grid.Row="0" Padding="20 14" CornerRadius="8 8 0 0"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="3.4*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Style>
                    </Grid.Resources>
                    <TextBlock Grid.Column="0" Text="Nhân viên"/>
                    <TextBlock Grid.Column="1" Text="Tên đăng nhập"/>
                    <TextBlock Grid.Column="2" Text="Vai trò"/>
                    <TextBlock Grid.Column="3" Text="Trạng thái"/>
                </Grid>

                <!--Row data-->
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.StaffCollection}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:User">
                                <!--1 dòng: kẻ phía trên; rê chuột vào/ra thì gọi hàm bên .xaml.cs
                                    (Background="Transparent" để bắt được chuột trên cả dòng)-->
                                <Grid Padding="20 14" Background="Transparent"
                                      BorderThickness="0 1 0 0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      PointerEntered="Row_PointerEntered"
                                      PointerExited="Row_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="3.4*"/>
                                    </Grid.ColumnDefinitions>

                                    <!--Name and Id Staff-->
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind FullName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind DisplayUserId}" FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{x:Bind Account}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind RoleText}" VerticalAlignment="Center"/>

                                    <!--Status account-->
                                    <Grid Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border Visibility="{x:Bind IsActive}" Padding="10 4" CornerRadius="4"
                                                BorderThickness="1" BorderBrush="#9FD89F" Background="#DFF6DD">
                                            <TextBlock Text="Đang hoạt động" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#0E700E"/>
                                        </Border>
                                        <Border Visibility="{x:Bind IsLocked}" Padding="10 4" CornerRadius="4"
                                                BorderThickness="1" BorderBrush="#F2C661" Background="#FFF4CE">
                                            <TextBlock Text="Đã khóa" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#8A5300"/>
                                        </Border>
                                    </Grid>

                                    <!--Actions-->
                                    <StackPanel x:Name="RowActions" Grid.Column="3" Visibility="Collapsed"
                                                Orientation="Horizontal" Spacing="4"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <controls:HandButton x:Name="ChangePassword" Click="ChangePassword_Click" Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="Đổi mật khẩu">
                                            <FontIcon Glyph="&#xE8D7;" FontSize="14"/>
                                        </controls:HandButton>
                                        <controls:HandButton x:Name="EditInfo" Click="EditInfo_Click" Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="Sửa thông tin">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                        </controls:HandButton>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
