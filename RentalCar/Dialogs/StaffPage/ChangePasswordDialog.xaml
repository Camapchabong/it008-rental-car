<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="RentalCar.Views.Dialogs.ChangePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Style="{StaticResource DefaultContentDialogStyle}"
    CornerRadius="12"
    BorderThickness="1"
    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
    PrimaryButtonText="Đổi mật khẩu"
    CloseButtonText="Hủy"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    >

    <ContentDialog.Resources>
        <!-- Nhãn phía trên mỗi ô nhập: đậm vừa, cỡ 14 -->
        <DataTemplate x:Key="FieldHeaderTemplate">
            <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </DataTemplate>
    </ContentDialog.Resources>

    <!-- Tiêu đề -->
    <ContentDialog.Title>
        <StackPanel Spacing="4">
            <TextBlock Text="Đổi mật khẩu" FontSize="24" FontWeight="SemiBold"/>
        </StackPanel>
    </ContentDialog.Title>

    <Grid Width="480" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
          ColumnSpacing="16" RowSpacing="20" Margin="0 8 0 0">

        <!-- Hàng 1: ghi chú -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Nhập mật khẩu mới cho tài khoản. Mật khẩu cũ không cần nhập và không thể xem lại."/>

        <!-- Hàng 2: Mật khẩu mới | Xác nhận mật khẩu mới -->
        <PasswordBox x:Name="NewPasswordBox" Grid.Row="1" Grid.Column="0"
                     Header="Mật khẩu mới" HeaderTemplate="{StaticResource FieldHeaderTemplate}"
                     PlaceholderText="Nhập mật khẩu mới"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="1" Grid.Column="1"
                     Header="Xác nhận mật khẩu" HeaderTemplate="{StaticResource FieldHeaderTemplate}"
                     PlaceholderText="Nhập lại mật khẩu mới"/>

        <!-- Hàng 3: thông báo lỗi -->
        <InfoBar x:Name="ErrorBar" Grid.Row="2" Grid.ColumnSpan="2"
                 Severity="Error" IsClosable="False" IsOpen="False"/>
    </Grid>
</ContentDialog>
